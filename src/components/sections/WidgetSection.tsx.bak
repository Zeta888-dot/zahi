"use client";

/* eslint-disable @next/next/no-img-element */

import Image from "next/image";
import {
  useEffect,
  useRef,
  useState,
  type ChangeEvent,
  type CSSProperties,
} from "react";

const accentColors = [
  { name: "Ocean", value: "#28769D" },
  { name: "Ink", value: "#111315" },
  { name: "Emerald", value: "#4DA878" },
  { name: "Coral", value: "#D85D5D" },
];

const positions = [
  { value: "Bottom right", short: "Right" },
  { value: "Bottom left", short: "Left" },
  { value: "Inline", short: "Inline" },
] as const;

type Position = (typeof positions)[number]["value"];
type Stage = "upload" | "generating" | "result";

const productColors = [
  { name: "Black", value: "#111315" },
  { name: "Cream", value: "#F1F0EE" },
  { name: "Red", value: "#D85D5D" },
];

const sizes = ["S", "M", "L", "XL"];

const DEFAULT_PHOTO = "/hero/model.png";
const RESULT_PHOTO = "/hero/try-on-result.png";
const GENERATE_MS = 1800;

const labelCls = "text-[11px] font-semibold tracking-[0.14em] text-[#718087]";

const stageCopy: Record<Stage, { title: string; sub: string }> = {
  upload: {
    title: "Upload your photo",
    sub: "Full-body, standing straight, works best.",
  },
  generating: {
    title: "Generating your try-on",
    sub: "Matching fit, fabric and lighting.",
  },
  result: {
    title: "Your try-on is ready",
    sub: "Download it or start over.",
  },
};

/*
  Buttons get their size, padding and font from inline styles on purpose.
  The global button reset in globals.css is outside any cascade layer, so it
  beats Tailwind padding, margin and font-size utilities on <button>.
*/
const btnBase: CSSProperties = {
  display: "inline-flex",
  alignItems: "center",
  justifyContent: "center",
  gap: 10,
  height: 38,
  padding: "0 18px",
  fontSize: 13,
  fontWeight: 600,
  lineHeight: 1,
  whiteSpace: "nowrap",
  borderRadius: 9999,
  border: 0,
  cursor: "pointer",
};

const btnBlock: CSSProperties = {
  ...btnBase,
  display: "flex",
  width: "100%",
  height: 48,
};

const btnChip: CSSProperties = {
  ...btnBase,
  width: 40,
  height: 40,
  padding: 0,
  gap: 0,
};

const btnSmall: CSSProperties = {
  ...btnBase,
  height: 28,
  padding: "0 12px",
  fontSize: 12,
  gap: 6,
};

const btnIcon: CSSProperties = {
  ...btnBase,
  width: 28,
  height: 28,
  padding: 0,
  gap: 0,
};

function useInView<T extends HTMLElement>() {
  const ref = useRef<T>(null);
  const [inView, setInView] = useState(false);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setInView(true);
          observer.disconnect();
        }
      },
      { threshold: 0.12 }
    );
    observer.observe(el);
    return () => observer.disconnect();
  }, []);

  return { ref, inView };
}

function StatusPill({
  tone,
  label,
}: {
  tone: "green" | "blue" | "muted";
  label: string;
}) {
  const dot =
    tone === "green"
      ? "bg-[#4DA878]"
      : tone === "blue"
        ? "animate-pulse bg-[#28769D]"
        : "bg-[#C4DBE5]";

  return (
    <span className="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full bg-[#F2F9FC] px-3 py-1.5 text-[12px] font-medium text-[#46535A]">
      <span className={`h-1.5 w-1.5 rounded-full transition-colors duration-300 ${dot}`} />
      {label}
    </span>
  );
}

function Attr({ name, value }: { name: string; value: string }) {
  return (
    <>
      {"  "}
      <span className="text-[#9CCFB0]">{name}</span>
      <span className="text-[#7C8B93]">=</span>
      <span className="text-[#E8BE8F]">{`"${value}"`}</span>
      {"\n"}
    </>
  );
}

function ZMark({ color, size = 20 }: { color: string; size?: number }) {
  return (
    <span
      className="flex shrink-0 items-center justify-center rounded-full bg-white text-[10px] font-bold"
      style={{ width: size, height: size, color }}
    >
      z.
    </span>
  );
}

export default function WidgetSection() {
  const [accent, setAccent] = useState(accentColors[0].value);
  const [pos, setPos] = useState<Position>("Bottom right");
  const [open, setOpen] = useState(false);
  const [stage, setStage] = useState<Stage>("upload");
  const [photo, setPhoto] = useState(DEFAULT_PHOTO);
  const [custom, setCustom] = useState(false);
  const [prog, setProg] = useState(0);
  const [copied, setCopied] = useState(false);
  const [size, setSize] = useState("M");
  const [color, setColor] = useState(productColors[0].value);

  const fileRef = useRef<HTMLInputElement>(null);
  const blobRef = useRef<string | null>(null);
  const windowRef = useRef<HTMLDivElement>(null);
  const copyTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const { ref, inView } = useInView<HTMLDivElement>();

  const inline = pos === "Inline";
  const positionValue = pos.toLowerCase().replace(" ", "-");

  const embedCode = `<script
  src="https://cdn.zahi.pk/widget.js"
  data-store="yourstore"
  data-accent="${accent}"
  data-position="${positionValue}"
  async
></script>`;

  // Fake generation, runs while the stage is "generating"
  useEffect(() => {
    if (stage !== "generating") return;
    const t = setTimeout(() => setProg(100), 60);
    const t2 = setTimeout(() => setStage("result"), GENERATE_MS);
    return () => {
      clearTimeout(t);
      clearTimeout(t2);
    };
  }, [stage]);

  // On mobile the preview is tall, so bring the opened widget into view
  useEffect(() => {
    if (!open) return;
    if (!window.matchMedia("(max-width: 1023px)").matches) return;

    const t = setTimeout(() => {
      const el = windowRef.current;
      if (!el) return;
      const rect = el.getBoundingClientRect();
      const visible = rect.top >= 96 && rect.bottom <= window.innerHeight - 16;
      if (visible) return;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      el.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: "center",
      });
    }, 250);

    return () => clearTimeout(t);
  }, [open]);

  const openWidget = () => {
    setStage("upload");
    setOpen(true);
  };

  const closeWidget = () => setOpen(false);

  const startGenerate = () => {
    setProg(0);
    setStage("generating");
  };

  const releaseBlob = () => {
    if (blobRef.current) {
      URL.revokeObjectURL(blobRef.current);
      blobRef.current = null;
    }
  };

  const startOver = () => {
    releaseBlob();
    setPhoto(DEFAULT_PHOTO);
    setCustom(false);
    setStage("upload");
  };

  const onFile = (e: ChangeEvent<HTMLInputElement>) => {
    const f = e.target.files?.[0];
    if (!f) return;
    releaseBlob();
    const url = URL.createObjectURL(f);
    blobRef.current = url;
    setPhoto(url);
    setCustom(true);
    e.target.value = "";
  };

  const copy = async () => {
    try {
      await navigator.clipboard.writeText(embedCode);
      setCopied(true);
      if (copyTimer.current) clearTimeout(copyTimer.current);
      copyTimer.current = setTimeout(() => setCopied(false), 1800);
    } catch {
      /* clipboard can be blocked, nothing to do */
    }
  };

  const launcherPos =
    pos === "Bottom right"
      ? "right-4 bottom-4 sm:right-6 sm:bottom-6"
      : "left-4 bottom-4 sm:left-6 sm:bottom-6";

  const windowPos =
    pos === "Bottom right"
      ? "right-4 bottom-4 sm:right-6 sm:bottom-6"
      : pos === "Bottom left"
        ? "left-4 bottom-4 sm:left-6 sm:bottom-6"
        : "left-0 right-0 mx-auto bottom-4 sm:bottom-6";

  const caption = open
    ? "Upload a photo or keep the default model to see a result."
    : inline
      ? "Click Try it on to open the widget."
      : "Click the zahi button to open the widget.";

  const reveal = (delay: string) =>
    `transition-all duration-1000 ease-out motion-reduce:transition-none ${delay} ${
      inView ? "translate-y-0 opacity-100" : "translate-y-6 opacity-0"
    }`;

  const boxCls =
    "relative mt-4 block h-56 w-full overflow-hidden rounded-[16px] bg-[#F8FCFE]";

  return (
    <section id="widget" className="zahi-section relative isolate scroll-mt-20 overflow-hidden">
      <style>{`
        @keyframes zahi-window-in {
          0% { opacity: 0; transform: translateY(12px) scale(0.97); }
          100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes zahi-scan {
          0% { transform: translateY(-100%); }
          100% { transform: translateY(14rem); }
        }
        .zahi-window-anim { animation: zahi-window-in 350ms ease both; }
        .zahi-scan-anim { top: 0; animation: zahi-scan 1.2s ease-in-out infinite; }
        @media (prefers-reduced-motion: reduce) {
          .zahi-window-anim, .zahi-scan-anim { animation: none; }
        }
      `}</style>

      {/* Background, fades at top and bottom so it blends with neighbouring sections */}
      <div
        aria-hidden
        className="pointer-events-none absolute inset-0 -z-10 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent,black_18%,black_82%,transparent)]"
      >
        <div className="absolute top-[12%] left-[-10%] h-[460px] w-[460px] rounded-full bg-[radial-gradient(closest-side,rgba(139,92,246,0.14),transparent)] blur-3xl" />
        <div className="absolute top-[30%] left-1/2 h-[520px] w-[820px] max-w-[140vw] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(40,118,157,0.16),transparent)] blur-3xl" />
        <div className="absolute right-[-8%] bottom-[6%] h-[420px] w-[420px] rounded-full bg-[radial-gradient(closest-side,rgba(251,146,120,0.16),transparent)] blur-3xl" />
      </div>

      <div ref={ref} className="zahi-content relative py-24 lg:py-32">
        {/* Header */}
        <div className="mx-auto max-w-[760px] text-center">
          <h2
            className={`zahi-heading text-[40px] leading-[1.05] tracking-[-0.035em] sm:text-[52px] lg:text-[68px] ${reveal(
              "delay-0"
            )}`}
          >
            <span className="block">One script tag,</span>
            <span className="zahi-blue block">any website.</span>
          </h2>

          <p
            className={`zahi-body mx-auto mt-6 max-w-[520px] text-[16px] leading-[1.7] lg:mt-8 lg:text-[18px] ${reveal(
              "delay-150"
            )}`}
          >
            Not on Shopify or WooCommerce? Paste one line and the try-on
            widget lives on your site. Customize colors, position, and
            behavior to match your brand.
          </p>
        </div>

        {/* Demo */}
        <div className="mx-auto mt-14 grid max-w-[1120px] gap-6 lg:mt-16 lg:grid-cols-[0.85fr_1.15fr] lg:gap-8">
          {/* Left: controls and embed code */}
          <div className={reveal("delay-300")}>
            <div className="flex h-full flex-col overflow-hidden rounded-[28px] bg-white ring-1 ring-black/[0.06] shadow-[0_40px_100px_-40px_rgba(17,19,21,0.25)]">
              <div className="flex items-center justify-between gap-3 border-b border-[#E2EEF3] px-6 py-4 lg:px-7">
                <span className={labelCls}>CUSTOMIZE</span>
                <StatusPill tone="green" label="Live preview" />
              </div>

              <div className="flex flex-1 flex-col gap-8 p-6 lg:p-7">
                {/* Accent color */}
                <div>
                  <div className="flex items-center justify-between">
                    <p className={labelCls}>ACCENT COLOR</p>
                    <span className="text-[12px] text-[#718087]">{accent.toUpperCase()}</span>
                  </div>
                  <div role="radiogroup" aria-label="Accent color" className="mt-4 flex gap-3">
                    {accentColors.map((c) => {
                      const active = accent === c.value;
                      return (
                        <button
                          key={c.value}
                          type="button"
                          role="radio"
                          aria-checked={active}
                          aria-label={c.name}
                          onClick={() => setAccent(c.value)}
                          className="h-9 w-9 rounded-full transition-all duration-200"
                          style={{
                            backgroundColor: c.value,
                            boxShadow: active
                              ? `0 0 0 2px #ffffff, 0 0 0 4px ${c.value}`
                              : "inset 0 0 0 1px rgba(17,19,21,0.08)",
                          }}
                        />
                      );
                    })}
                  </div>
                </div>

                {/* Position */}
                <div>
                  <p className={labelCls}>POSITION</p>
                  <div
                    role="radiogroup"
                    aria-label="Widget position"
                    className="mt-4 grid grid-cols-3 gap-1 rounded-full bg-[#F2F9FC] p-1 ring-1 ring-black/[0.04]"
                  >
                    {positions.map((p) => {
                      const active = pos === p.value;
                      return (
                        <button
                          key={p.value}
                          type="button"
                          role="radio"
                          aria-checked={active}
                          aria-label={p.value}
                          onClick={() => setPos(p.value)}
                          style={{ ...btnBase, width: "100%", padding: "0 8px" }}
                          className={`transition-all duration-300 ${
                            active
                              ? "bg-[#111315] text-white shadow-sm"
                              : "bg-transparent text-[#46535A] hover:text-[#111315]"
                          }`}
                        >
                          <span className="sm:hidden">{p.short}</span>
                          <span className="hidden sm:inline">{p.value}</span>
                        </button>
                      );
                    })}
                  </div>
                </div>

                {/* Embed code */}
                <div className="flex flex-1 flex-col">
                  <p className={labelCls}>EMBED CODE</p>
                  <div className="mt-4 flex flex-1 flex-col overflow-hidden rounded-[20px] bg-[#0F1418] ring-1 ring-black/10">
                    <div className="flex items-center justify-between border-b border-white/[0.08] px-5 py-3">
                      <div className="flex items-center gap-4">
                        <div aria-hidden className="flex gap-1.5">
                          <span className="h-2.5 w-2.5 rounded-full bg-white/15" />
                          <span className="h-2.5 w-2.5 rounded-full bg-white/15" />
                          <span className="h-2.5 w-2.5 rounded-full bg-white/15" />
                        </div>
                        <span className="text-[12px] text-[#7C8B93]">index.html</span>
                      </div>
                      <button
                        type="button"
                        onClick={copy}
                        style={btnSmall}
                        className="bg-white/[0.08] text-[#C9D6DC] transition-colors duration-200 hover:bg-white/[0.14] hover:text-white"
                      >
                        {copied ? (
                          <svg width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden>
                            <path
                              d="M2.5 6.2L5 8.7L9.5 3.7"
                              stroke="#7FD1A0"
                              strokeWidth="1.6"
                              strokeLinecap="round"
                              strokeLinejoin="round"
                            />
                          </svg>
                        ) : (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden>
                            <rect x="9" y="9" width="11" height="11" rx="2.5" stroke="currentColor" strokeWidth="2" />
                            <path
                              d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"
                              stroke="currentColor"
                              strokeWidth="2"
                              strokeLinecap="round"
                            />
                          </svg>
                        )}
                        <span aria-live="polite">{copied ? "Copied" : "Copy"}</span>
                      </button>
                    </div>

                    <pre className="flex-1 overflow-x-auto px-5 py-5 font-mono text-[13px] leading-[1.9] text-[#C9D6DC]">
                      <code>
                        <span className="text-[#7C8B93]">{"<"}</span>
                        <span className="text-[#7FB8D6]">script</span>
                        {"\n"}
                        <Attr name="src" value="https://cdn.zahi.pk/widget.js" />
                        <Attr name="data-store" value="yourstore" />
                        <Attr name="data-accent" value={accent} />
                        <Attr name="data-position" value={positionValue} />
                        {"  "}
                        <span className="text-[#9CCFB0]">async</span>
                        {"\n"}
                        <span className="text-[#7C8B93]">{"></"}</span>
                        <span className="text-[#7FB8D6]">script</span>
                        <span className="text-[#7C8B93]">{">"}</span>
                      </code>
                    </pre>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Right: live product page preview */}
          <div className={reveal("delay-500")}>
            <div className="relative flex h-full flex-col overflow-hidden rounded-[28px] bg-white ring-1 ring-black/[0.06] shadow-[0_40px_100px_-40px_rgba(17,19,21,0.25)] lg:min-h-[640px]">
              {/* Browser bar */}
              <div className="flex items-center justify-between gap-3 border-b border-[#E2EEF3] px-6 py-4 lg:px-7">
                <div className="flex min-w-0 items-center gap-4">
                  <div aria-hidden className="hidden gap-1.5 sm:flex">
                    <span className="h-2.5 w-2.5 rounded-full bg-[#E2EEF3]" />
                    <span className="h-2.5 w-2.5 rounded-full bg-[#E2EEF3]" />
                    <span className="h-2.5 w-2.5 rounded-full bg-[#E2EEF3]" />
                  </div>
                  <span className="min-w-0 truncate rounded-full bg-[#F2F9FC] px-4 py-1.5 text-[12px] text-[#718087]">
                    yourstore.com/products/racing-graphic-tee
                  </span>
                </div>
                <StatusPill tone="green" label="Store live" />
              </div>

              {/* Product page body, bottom padding leaves room for the floating button */}
              <div className="grid flex-1 gap-6 p-6 pb-[88px] sm:grid-cols-2 sm:items-start lg:gap-8 lg:p-8 lg:pb-[88px]">
                <div className="relative aspect-[4/5] overflow-hidden rounded-[20px] bg-[#F2F9FC] sm:aspect-[3/4]">
                  <Image
                    src="/hero/garment.png"
                    alt="Racing Graphic Tee"
                    fill
                    sizes="(min-width: 1024px) 280px, (min-width: 640px) 40vw, 90vw"
                    className="object-cover"
                  />
                </div>

                <div className="flex flex-col">
                  <p className="text-[12px] tracking-[0.04em] text-[#718087]">Home / Tees</p>
                  <h3 className="zahi-heading mt-3 text-[22px] leading-[1.15]">
                    Racing Graphic Tee
                  </h3>
                  <div className="mt-2.5 flex items-center gap-2 text-[12px] text-[#718087]">
                    <span aria-hidden className="text-[11px] tracking-[0.1em] text-[#F2B33D]">
                      ★★★★★
                    </span>
                    <span>128 reviews</span>
                  </div>
                  <p className="zahi-display mt-3 text-[22px]">PKR 4,900</p>

                  <div className="mt-6">
                    <p className={labelCls}>COLOR</p>
                    <div role="radiogroup" aria-label="Color" className="mt-3 flex gap-3">
                      {productColors.map((c) => {
                        const active = color === c.value;
                        return (
                          <button
                            key={c.value}
                            type="button"
                            role="radio"
                            aria-checked={active}
                            aria-label={c.name}
                            onClick={() => setColor(c.value)}
                            className="h-7 w-7 rounded-full transition-all duration-200"
                            style={{
                              backgroundColor: c.value,
                              boxShadow: active
                                ? "inset 0 0 0 1px rgba(17,19,21,0.12), 0 0 0 2px #ffffff, 0 0 0 4px #111315"
                                : "inset 0 0 0 1px rgba(17,19,21,0.12)",
                            }}
                          />
                        );
                      })}
                    </div>
                  </div>

                  <div className="mt-6">
                    <p className={labelCls}>SIZE</p>
                    <div role="radiogroup" aria-label="Size" className="mt-3 flex gap-2">
                      {sizes.map((s) => (
                        <button
                          key={s}
                          type="button"
                          role="radio"
                          aria-checked={size === s}
                          onClick={() => setSize(s)}
                          style={btnChip}
                          className={`ring-1 transition-all duration-200 ${
                            size === s
                              ? "bg-[#111315] text-white ring-[#111315]"
                              : "bg-white text-[#46535A] ring-[#D5E6ED] hover:ring-[#111315]"
                          }`}
                        >
                          {s}
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* Gap comes from the parent, so buttons can never touch */}
                  <div className="mt-7 flex flex-col gap-4">
                    <button
                      type="button"
                      style={btnBlock}
                      className="bg-[#111315] text-white transition-colors duration-300 hover:bg-[#28769D]"
                    >
                      Add to cart
                    </button>

                    {inline && (
                      <button
                        type="button"
                        onClick={openWidget}
                        style={{
                          ...btnBlock,
                          backgroundColor: accent,
                          boxShadow: `0 14px 30px -14px ${accent}`,
                        }}
                        className="text-white transition-transform duration-300 hover:-translate-y-0.5"
                      >
                        <ZMark color={accent} />
                        Try it on
                      </button>
                    )}
                  </div>
                </div>
              </div>

              {/* Scrim, only for the inline position */}
              {open && inline && (
                <button
                  type="button"
                  aria-label="Close widget"
                  onClick={closeWidget}
                  className="absolute inset-0 z-10 cursor-default bg-[#111315]/25 backdrop-blur-[2px]"
                />
              )}

              {/* Widget window */}
              {open && (
                <div
                  ref={windowRef}
                  role="dialog"
                  aria-label="zahi try-on widget"
                  className={`zahi-window-anim absolute z-20 flex max-h-[calc(100%-2rem)] w-[calc(100%-2rem)] max-w-[320px] flex-col overflow-hidden rounded-[22px] bg-white shadow-[0_30px_80px_-20px_rgba(17,19,21,0.35)] ring-1 ring-black/[0.06] ${windowPos}`}
                >
                  <div
                    className="flex shrink-0 items-center justify-between px-5 py-3.5"
                    style={{ backgroundColor: accent }}
                  >
                    <div className="flex items-center gap-2.5">
                      <ZMark color={accent} size={28} />
                      <span className="text-[13px] font-semibold text-white">zahi try-on</span>
                    </div>
                    <button
                      type="button"
                      onClick={closeWidget}
                      aria-label="Close widget"
                      style={btnIcon}
                      className="bg-white/0 text-white/80 transition-colors hover:bg-white/15 hover:text-white"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden>
                        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" strokeWidth="2" strokeLinecap="round" />
                      </svg>
                    </button>
                  </div>

                  {/* Same structure in every stage, so the window never changes height */}
                  <div className="min-h-0 flex-1 overflow-y-auto p-5">
                    <p className="text-[14px] font-semibold text-[#111315]">
                      {stageCopy[stage].title}
                    </p>
                    <p className="mt-1 text-[12px] leading-[1.5] text-[#718087]">
                      {stageCopy[stage].sub}
                    </p>

                    {stage === "upload" ? (
                      <button
                        type="button"
                        onClick={() => fileRef.current?.click()}
                        aria-label="Choose a photo"
                        className={`${boxCls} border border-dashed border-[#C4DBE5] transition-colors duration-200 hover:border-[#28769D]`}
                      >
                        <img src={photo} alt="Your photo" className="h-full w-full object-contain" />
                        {!custom && (
                          <span className="absolute top-3 left-3 rounded-full bg-[#111315]/80 px-2.5 py-1 text-[10px] font-semibold tracking-[0.1em] text-white">
                            DEFAULT MODEL
                          </span>
                        )}
                        <span className="absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-[11px] font-semibold text-[#46535A] shadow-sm">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden>
                            <path
                              d="M12 16V5M12 5L8 9M12 5l4 4M5 19h14"
                              stroke="currentColor"
                              strokeWidth="2"
                              strokeLinecap="round"
                              strokeLinejoin="round"
                            />
                          </svg>
                          Change photo
                        </span>
                      </button>
                    ) : (
                      <div className={boxCls}>
                        {stage === "generating" ? (
                          <>
                            <img src={photo} alt="" className="h-full w-full object-contain opacity-70" />
                            <div
                              aria-hidden
                              className="zahi-scan-anim absolute inset-x-0 h-16"
                              style={{
                                background: `linear-gradient(to bottom, transparent, ${accent}40, transparent)`,
                              }}
                            />
                          </>
                        ) : (
                          <>
                            <img src={RESULT_PHOTO} alt="Try-on result" className="h-full w-full object-contain" />
                            <span className="absolute top-3 left-3 rounded-full bg-[#111315]/85 px-2.5 py-1 text-[10px] font-semibold tracking-[0.1em] text-white">
                              READY IN 8s
                            </span>
                          </>
                        )}
                      </div>
                    )}

                    <input
                      ref={fileRef}
                      type="file"
                      accept="image/*"
                      className="hidden"
                      onChange={onFile}
                    />

                    <div className="mt-5 h-11">
                      {stage === "upload" && (
                        <button
                          type="button"
                          onClick={startGenerate}
                          style={{
                            ...btnBlock,
                            height: 44,
                            backgroundColor: accent,
                            boxShadow: `0 12px 26px -12px ${accent}`,
                          }}
                          className="text-white transition-transform duration-300 hover:-translate-y-0.5"
                        >
                          Generate try-on
                        </button>
                      )}

                      {stage === "generating" && (
                        <div className="flex h-11 items-center">
                          <div className="h-1 w-full overflow-hidden rounded-full bg-[#E2EEF3]">
                            <div
                              className="h-full rounded-full"
                              style={{
                                width: `${prog}%`,
                                transition: "width 1.5s linear",
                                backgroundColor: accent,
                              }}
                            />
                          </div>
                        </div>
                      )}

                      {stage === "result" && (
                        <div className="flex h-11 gap-2.5">
                          
                            href={RESULT_PHOTO}
                            download="zahi-try-on.png"
                            style={{ ...btnBase, flex: 1, height: 44 }}
                            className="bg-[#111315] text-white transition-colors duration-300 hover:bg-[#28769D]"
                          >
                            Download
                          </a>
                          <button
                            type="button"
                            onClick={startOver}
                            style={{ ...btnBase, flex: 1, height: 44 }}
                            className="bg-white text-[#46535A] ring-1 ring-[#D5E6ED] transition-all duration-200 hover:text-[#111315] hover:ring-[#111315]"
                          >
                            Start over
                          </button>
                        </div>
                      )}
                    </div>
                  </div>

                  <p className="shrink-0 border-t border-[#E2EEF3] px-5 py-3 text-center text-[11px] text-[#9BAAB1]">
                    Powered by zahi
                  </p>
                </div>
              )}

              {/* Floating launcher, for the two corner positions */}
              {!open && !inline && (
                <button
                  type="button"
                  onClick={openWidget}
                  aria-label="Open zahi try-on widget"
                  style={{
                    ...btnBase,
                    height: 44,
                    padding: "0 20px 0 8px",
                    backgroundColor: accent,
                    boxShadow: `0 16px 34px -14px ${accent}`,
                  }}
                  className={`absolute z-10 text-white transition-transform duration-300 hover:-translate-y-0.5 ${launcherPos}`}
                >
                  <ZMark color={accent} size={28} />
                  Try it on
                </button>
              )}
            </div>
          </div>
        </div>

        <p
          className={`mt-8 text-center text-[13px] text-[#718087] ${reveal("delay-700")}`}
          aria-live="polite"
        >
          {caption}
        </p>
      </div>
    </section>
  );
}